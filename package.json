{
  "name": "agent-relay",
  "version": "0.4.0",
  "description": "VPS deployment relay — MCP server + HTTP API for Docker Compose apps",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dockerode": "^4.0.4",
    "hono": "^4.7.9",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dockerode": "^3.3.38",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.18",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "protobufjs": "^7.5.8",
    "uuid": "^14.0.0"
  }
}
