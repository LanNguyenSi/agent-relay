# Agent Relay Configuration
PORT=8222
# Bearer token for the API and MCP; empty fails closed. Generate one: openssl rand -hex 32
AUTH_TOKEN=
# Container path. For `npm run dev` on the host use APPS_DIR=./apps.
APPS_DIR=/apps
# Host directory the dev docker-compose.yml bind-mounts at /apps: `docker
# compose` reads APPS_HOST_DIR as the host directory. APPS_DIR is only the
# in-container path (on the host it is what `npm run dev` reads).
# APPS_HOST_DIR=./apps
# Docker build cache kept after a successful deploy (docker builder prune
# --filter until=<value>): digits + h or m. Empty or invalid falls back to 168h.
RELAY_BUILD_CACHE_KEEP=168h
